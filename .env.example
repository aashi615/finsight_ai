# Runtime: development, test, or production. Production requires PostgreSQL and a 32+ character JWT secret.
ENVIRONMENT=development
DEBUG=false
# PostgreSQL connection URL; do not use SQLite in production.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
POSTGRES_DB=equitylens
POSTGRES_USER=equitylens
POSTGRES_PASSWORD=CHANGE_ME
# Authentication configuration.
JWT_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated browser origins permitted to call the API; use deployed HTTPS frontend URL(s) in production.
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173
MAX_REQUEST_BODY_BYTES=1000000
RESEARCH_RATE_LIMIT_PER_MINUTE=5
# External providers: server-side only, never expose to the frontend.
FINNHUB_API_KEY=YOUR_FINNHUB_KEY
LLM_PROVIDER=groq
GROQ_API_KEY=YOUR_GROQ_KEY
GROQ_RESEARCH_MODEL=openai/gpt-oss-20b
GROQ_FINAL_MODEL=qwen/qwen3.6-27b
# Used only if GPT-OSS exhausts completion tokens on internal reasoning.
GROQ_REASONING_FALLBACK_MODEL=qwen/qwen3.6-27b
# Per-agent ceilings; the shared budget below is the actual Free Tier guard.
NEWS_MAX_OUTPUT_TOKENS=1600
MARKET_MAX_OUTPUT_TOKENS=1400
RAG_MAX_OUTPUT_TOKENS=1200
FINAL_MAX_OUTPUT_TOKENS=1200
FINAL_COMPACT_MAX_OUTPUT_TOKENS=600
FINAL_FALLBACK_MAX_OUTPUT_TOKENS=400
# Input + reasoning + visible completion tokens, shared across all agents.
GROQ_TPM_LIMIT=7000
GROQ_SAFE_TPM_LIMIT=7000
MAX_LLM_RETRIES=2
GROQ_RETRY_SAFETY_SECONDS=0.25
GROQ_TPM_RECHECK_SECONDS=6
NEWS_ARTICLE_LIMIT=6
NEWS_ARTICLE_SNIPPET_CHARS=280
MARKET_HISTORY_POINTS_LIMIT=12
RAG_TOP_K=3
RAG_CHUNK_CHARS=600
YAHOO_MAX_RETRIES=1
YAHOO_RETRY_SECONDS=1.0

# Runtime: development, test, or production.
# Production requires PostgreSQL and a 32+ character JWT secret.
ENVIRONMENT=development
DEBUG=false

# PostgreSQL connection URL; do not use SQLite in production.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

POSTGRES_DB=equitylens
POSTGRES_USER=equitylens
POSTGRES_PASSWORD=CHANGE_ME

# Authentication configuration.
JWT_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Browser origins permitted to call the API.
# Use deployed HTTPS frontend URL(s) in production.
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173

MAX_REQUEST_BODY_BYTES=1000000
RESEARCH_RATE_LIMIT_PER_MINUTE=5

# -------------------------------------------------------------------
# External providers
# -------------------------------------------------------------------

FINNHUB_API_KEY=YOUR_FINNHUB_KEY

# LLM provider
LLM_PROVIDER=groq
GROQ_API_KEY=YOUR_GROQ_KEY

# -------------------------------------------------------------------
# Groq model routing
# -------------------------------------------------------------------

# News / Market / RAG
# These use GPT-OSS-20B.
GROQ_RESEARCH_MODEL=openai/gpt-oss-20b

# Final synthesis uses a separate model so it does not compete with
# the GPT-OSS research requests for the same TPM budget.
GROQ_FINAL_MODEL=qwen/qwen3.6-27b

# Same Qwen model is used as the research-agent fallback.
GROQ_REASONING_FALLBACK_MODEL=qwen/qwen3.6-27b

# -------------------------------------------------------------------
# Completion budgets
# -------------------------------------------------------------------
# Groq TPM = input tokens + output tokens.
#
# These are maximum completion-token reservations, not total request
# token limits.

NEWS_MAX_OUTPUT_TOKENS=800
MARKET_MAX_OUTPUT_TOKENS=900
RAG_MAX_OUTPUT_TOKENS=800
FINAL_MAX_OUTPUT_TOKENS=1000

# -------------------------------------------------------------------
# Groq TPM protection
# -------------------------------------------------------------------

# Groq project/model TPM limit.
GROQ_TPM_LIMIT=8000

# Keep local reservation below the hard server-side limit to leave
# headroom for estimation differences.
GROQ_SAFE_TPM_LIMIT=7000

# Retry transient provider errors.
MAX_LLM_RETRIES=2

# -------------------------------------------------------------------
# Research input/data limits
# -------------------------------------------------------------------

NEWS_ARTICLE_LIMIT=6
NEWS_ARTICLE_SNIPPET_CHARS=280

MARKET_HISTORY_POINTS_LIMIT=12

RAG_TOP_K=3
RAG_CHUNK_CHARS=600